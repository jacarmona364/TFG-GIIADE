[Unit]
Description=Mi Tosta - Terminal de Cocina
After=network.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/TFG-GIIADE/Dashboard
ExecStart=/home/azureuser/TFG-GIIADE/Dashboard/venv/bin/streamlit run app_cocina.py --server.port=8502 --server.address=0.0.0.0
